<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HanautaSketch.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <!-- Lutica Design System（FluentTheme を内包する） -->
        <StyleInclude Source="avares://HanautaSketch/Themes/LuticaTheme.axaml" />
    </Application.Styles>
</Application>
