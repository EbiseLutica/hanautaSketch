<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HanautaSketch.Views.ConfirmWindow"
        Title="hanautaSketch"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16" MinWidth="320">
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="520" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" Content="OK" Classes="primary" Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" IsDefault="True" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
