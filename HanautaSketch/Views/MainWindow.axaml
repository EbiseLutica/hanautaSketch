<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HanautaSketch.ViewModels"
        xmlns:c="using:HanautaSketch.Controls"
        xmlns:res="using:HanautaSketch.Resources"
        x:Class="HanautaSketch.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMidiCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>
    <!--
        macOS の画面上端のメニューバー（Windows では使わない）。並びと名前は macOS の慣例に合わせる。
        アプリ名のメニュー（について・終了など）は App.axaml。ショートカットは macOS 専用なので最初から ⌘（Meta）で書く
    -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static res:Strings.NativeFile}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.NativeNew}" Command="{Binding NewCommand}" Gesture="Meta+N" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeOpen}" Command="{Binding OpenCommand}" Gesture="Meta+O" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeClose}" Click="OnCloseWindow" Gesture="Meta+W" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeSave}" Command="{Binding SaveCommand}" Gesture="Meta+S" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeSaveAs}" Command="{Binding SaveAsCommand}" Gesture="Meta+Shift+S" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeExportMidi}" Command="{Binding ExportMidiCommand}" Gesture="Meta+E" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{x:Static res:Strings.NativeEdit}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.NativeUndo}" Command="{Binding UndoCommand}" Gesture="Meta+Z" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeRedo}" Command="{Binding RedoCommand}" Gesture="Meta+Shift+Z" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{x:Static res:Strings.NativeTools}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.NativeAcquireChordData}" Command="{Binding AcquireChordDataCommand}" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeCancelChordData}" Command="{Binding CancelChordDataCommand}" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeRemoveChordData}" Command="{Binding RemoveChordDataCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.ThemeMenu}">
                        <NativeMenu>
                            <NativeMenuItem Header="{x:Static res:Strings.ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="system"
                                            ToggleType="Radio" IsChecked="{Binding IsThemeSystem}" />
                            <NativeMenuItem Header="{x:Static res:Strings.ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="light"
                                            ToggleType="Radio" IsChecked="{Binding IsThemeLight}" />
                            <NativeMenuItem Header="{x:Static res:Strings.ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="dark"
                                            ToggleType="Radio" IsChecked="{Binding IsThemeDark}" />
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="{x:Static res:Strings.LanguageMenu}">
                        <NativeMenu>
                            <NativeMenuItem Header="{x:Static res:Strings.LanguageSystem}" Command="{Binding SetLanguageCommand}" CommandParameter="system"
                                            ToggleType="Radio" IsChecked="{Binding IsLanguageSystem}" />
                            <NativeMenuItem Header="{x:Static res:Strings.LanguageJapanese}" Command="{Binding SetLanguageCommand}" CommandParameter="ja"
                                            ToggleType="Radio" IsChecked="{Binding IsLanguageJapanese}" />
                            <NativeMenuItem Header="{x:Static res:Strings.LanguageEnglish}" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                                            ToggleType="Radio" IsChecked="{Binding IsLanguageEnglish}" />
                        </NativeMenu>
                    </NativeMenuItem>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{x:Static res:Strings.NativeWindow}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.NativeMinimize}" Click="OnMinimizeWindow" Gesture="Meta+M" />
                    <NativeMenuItem Header="{x:Static res:Strings.NativeZoom}" Click="OnZoomWindow" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{x:Static res:Strings.NativeHelp}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.NativeDataSources}" Click="OnShowDataSources" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>
    <DockPanel>
        <!-- メニューバー（Windows 用。macOS では隠して上の NativeMenu を使う） -->
        <Menu x:Name="WindowMenu" DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.MenuFile}">
                <MenuItem Header="{x:Static res:Strings.MenuNew}" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="{x:Static res:Strings.MenuOpen}" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuSave}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="{x:Static res:Strings.MenuSaveAs}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuExportMidi}" Command="{Binding ExportMidiCommand}" InputGesture="Ctrl+E" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuEdit}">
                <MenuItem Header="{x:Static res:Strings.MenuUndo}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="{x:Static res:Strings.MenuRedo}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuTools}">
                <MenuItem Header="{x:Static res:Strings.MenuAcquireChordData}" Command="{Binding AcquireChordDataCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuCancelChordData}" Command="{Binding CancelChordDataCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuRemoveChordData}" Command="{Binding RemoveChordDataCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.ThemeMenu}">
                    <MenuItem Header="{x:Static res:Strings.ThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="system"
                              ToggleType="Radio" IsChecked="{Binding IsThemeSystem}" />
                    <MenuItem Header="{x:Static res:Strings.ThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="light"
                              ToggleType="Radio" IsChecked="{Binding IsThemeLight}" />
                    <MenuItem Header="{x:Static res:Strings.ThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="dark"
                              ToggleType="Radio" IsChecked="{Binding IsThemeDark}" />
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.LanguageMenu}">
                    <MenuItem Header="{x:Static res:Strings.LanguageSystem}" Command="{Binding SetLanguageCommand}" CommandParameter="system"
                              ToggleType="Radio" IsChecked="{Binding IsLanguageSystem}" />
                    <MenuItem Header="{x:Static res:Strings.LanguageJapanese}" Command="{Binding SetLanguageCommand}" CommandParameter="ja"
                              ToggleType="Radio" IsChecked="{Binding IsLanguageJapanese}" />
                    <MenuItem Header="{x:Static res:Strings.LanguageEnglish}" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                              ToggleType="Radio" IsChecked="{Binding IsLanguageEnglish}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuHelp}">
                <MenuItem Header="{x:Static res:Strings.MenuDataSources}" Click="OnShowDataSourcesMenuItem" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.AboutApp}" Click="OnShowAboutMenuItem" />
            </MenuItem>
        </Menu>

        <!-- ツールバー -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <ToggleButton Content="{x:Static res:Strings.TogglePlay}" Command="{Binding TogglePlaybackCommand}" IsChecked="{Binding IsPlaying, Mode=OneWay}" Width="80" />
            <TextBlock Text="BPM" VerticalAlignment="Center" Margin="8,0,0,0" />
            <NumericUpDown Value="{Binding Bpm}" Minimum="20" Maximum="400" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="Key" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding TonicNames}" SelectedIndex="{Binding Tonic}" Width="80" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="100" />
            <TextBlock Text="Snap" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding SnapOptions}" SelectedItem="{Binding SelectedSnap}" Width="90" />
        </StackPanel>

        <!-- ステータスバー -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding AudioStatus}" Classes="dimmed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0"
                        IsVisible="{Binding IsExtractingChordData}">
                <TextBlock Text="{Binding ChordDataStatus}" Classes="dimmed" VerticalAlignment="Center" />
                <Button Content="{x:Static res:Strings.StopExtraction}" Command="{Binding CancelChordDataCommand}" Classes="small" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Classes="dimmed" />
        </DockPanel>

        <!-- トラックメニュー：一覧、追加・削除、選択中トラックの設定 -->
        <DockPanel DockPanel.Dock="Left" Width="220" Classes="lu-panel">
            <StackPanel DockPanel.Dock="Bottom" Margin="8" Spacing="6">
                <TextBlock Text="{x:Static res:Strings.TrackInstrument}" />
                <StackPanel Spacing="6" IsVisible="{Binding !IsSelectedTrackDrum}">
                    <ComboBox ItemsSource="{Binding ProgramCategories}" SelectedIndex="{Binding SelectedProgramCategory}"
                              HorizontalAlignment="Stretch" />
                    <ComboBox ItemsSource="{Binding ProgramSlots}" SelectedIndex="{Binding SelectedProgramIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgramSlot">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding IsSelectedTrackDrum}">
                    <ComboBox ItemsSource="{Binding DrumKits}" SelectedIndex="{Binding SelectedDrumKitIndex}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DrumKitOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{x:Static res:Strings.TrackDrumKit}" Classes="caption" />
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.TrackVolume}" VerticalAlignment="Center" Width="40" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTrackVolume}" VerticalAlignment="Center"
                               Width="28" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="127" SmallChange="1" LargeChange="8" IsSnapToTickEnabled="True"
                            TickFrequency="1" Value="{Binding SelectedTrackVolume}" />
                </DockPanel>

                <!-- スマートコードトラックの設定 -->
                <Panel IsVisible="{Binding SelectedSmartTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6" DataContext="{Binding SelectedSmartTrack}" x:DataType="vm:SmartChordTrackViewModel">
                    <TextBlock Text="{x:Static res:Strings.SmartChordTitle}" Classes="title" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Static res:Strings.SmartChordBass}" />
                    <ComboBox ItemsSource="{Binding BassSourceOptions}" SelectedItem="{Binding BassSource}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Static res:Strings.SmartChordMelody}" />
                    <ComboBox ItemsSource="{Binding MelodySourceOptions}" SelectedItem="{Binding MelodySource}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Static res:Strings.SmartChordMinorDominant}" />
                    <ComboBox ItemsSource="{Binding MinorDominantModes}" SelectedItem="{Binding MinorDominant}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Static res:Strings.SmartChordPattern}" />
                    <ComboBox ItemsSource="{Binding PatternOptions}" SelectedItem="{Binding Pattern}" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static res:Strings.SmartChordRhythm}" VerticalAlignment="Center" Width="70" />
                        <ComboBox ItemsSource="{Binding DivisionOptions}" SelectedItem="{Binding Division}" Width="130" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static res:Strings.SmartChordVelocity}" VerticalAlignment="Center" Width="70" />
                        <NumericUpDown Value="{Binding Velocity}" Minimum="1" Maximum="127" Increment="1"
                                       FormatString="0" Width="130" />
                    </StackPanel>
                </StackPanel>
                </Panel>

                <!-- スマートドラムトラックの設定 -->
                <Panel IsVisible="{Binding SelectedDrumTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6" DataContext="{Binding SelectedDrumTrack}" x:DataType="vm:SmartDrumTrackViewModel">
                    <TextBlock Text="{x:Static res:Strings.SmartDrumTitle}" Classes="title" Margin="0,6,0,0" />
                    <TextBlock Text="{x:Static res:Strings.SmartDrumBass}" />
                    <ComboBox ItemsSource="{Binding BassSourceOptions}" SelectedItem="{Binding BassSource}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Static res:Strings.SmartDrumHint}" Classes="caption" TextWrapping="Wrap" />
                    <StackPanel Spacing="6" IsVisible="{Binding HasSection}">
                        <TextBlock Text="{x:Static res:Strings.SmartDrumPattern}" />
                        <ComboBox ItemsSource="{Binding PatternOptions}" SelectedItem="{Binding Pattern}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="{x:Static res:Strings.SmartDrumSwing}" IsChecked="{Binding Swing}" />
                        <DockPanel IsEnabled="{Binding Swing}">
                            <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.SmartDrumSwingAmount}" VerticalAlignment="Center" Width="40" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SwingAmount, StringFormat={}{0}%}" VerticalAlignment="Center"
                                       Width="36" TextAlignment="Right" />
                            <Slider x:Name="SwingSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding SwingAmount}" />
                        </DockPanel>
                        <TextBlock Text="{x:Static res:Strings.SmartDrumFollowBass}" />
                        <ComboBox ItemsSource="{Binding BassFollowOptions}" SelectedItem="{Binding BassFollow}" HorizontalAlignment="Stretch" />
                        <Button Content="{Binding FixLabel}" Command="{Binding ToggleFixCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="{x:Static res:Strings.SmartDrumDeleteSection}" Command="{Binding DeleteSectionCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
                </Panel>
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="6" RowSpacing="6" Margin="8,4">
                <Button Grid.Row="0" Grid.Column="0" Content="{x:Static res:Strings.TrackAddNote}" Command="{Binding AddNoteTrackCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="0" Grid.Column="1" Content="{x:Static res:Strings.TrackAddChord}" Command="{Binding AddSmartChordTrackCommand}" ToolTip.Tip="{x:Static res:Strings.TrackAddChordTip}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.TrackAddDrums}" Command="{Binding AddSmartDrumTrackCommand}" ToolTip.Tip="{x:Static res:Strings.TrackAddDrumsTip}" HorizontalAlignment="Stretch" />
                <Button Grid.Row="1" Grid.Column="1" Content="{x:Static res:Strings.TrackRemove}" Command="{Binding RemoveSelectedTrackCommand}" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 行: 名前（ダブルクリックで編集）、M（ミュート）・S（ソロ）。ドラッグで並び替え -->
            <ListBox x:Name="TrackList" ItemsSource="{Binding TrackItems}" SelectedItem="{Binding SelectedTrackItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                        <DockPanel Background="Transparent" DoubleTapped="OnTrackItemDoubleTapped">
                            <ToggleButton DockPanel.Dock="Right" Content="S" IsChecked="{Binding Solo}" ToolTip.Tip="{x:Static res:Strings.TrackSolo}"
                                          Classes="small" MinWidth="24" Margin="4,0,0,0" />
                            <ToggleButton DockPanel.Dock="Right" Content="M" IsChecked="{Binding Mute}" ToolTip.Tip="{x:Static res:Strings.TrackMute}"
                                          Classes="small" MinWidth="24" />
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static res:Strings.TrackSmartBadge}" Classes="caption"
                                       VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding IsSmart}" />
                            <Panel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !IsEditing}" />
                                <TextBox Text="{Binding EditingName}" IsVisible="{Binding IsEditing}" Padding="2,0"
                                         MinHeight="0" KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" />
                            </Panel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ピアノロール＋スクロールバー -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <c:PianoRollControl x:Name="Roll"
                                Song="{Binding Song}"
                                Track="{Binding SelectedTrack}"
                                ConductorRevision="{Binding ConductorRevision}"
                                SnapTicks="{Binding SelectedSnap.Ticks}"
                                Chords="{Binding Chords}"
                                PlayheadTick="{Binding PlayheadTick}"
                                PlayStartTick="{Binding PlayStartTick}"
                                NotesRevision="{Binding NotesRevision}"
                                NotesEdited="OnNotesEdited"
                                NotePreview="OnNotePreview"
                                EditStarted="OnEditStarted"
                                EditCompleted="OnEditCompleted"
                                ChordSegmentClicked="OnChordSegmentClicked"
                                DrumSections="{Binding DrumSections}"
                                SelectedDrumSection="{Binding SelectedDrumSection}"
                                DrumSectionRequested="OnDrumSectionRequested"
                                DrumSectionResizeRequested="OnDrumSectionResizeRequested"
                                ConductorLaneClicked="OnConductorLaneClicked"
                                ConductorChangeMoveRequested="OnConductorChangeMoveRequested" />
            <ScrollBar Grid.Column="1" Orientation="Vertical" AllowAutoHide="False"
                       Minimum="0"
                       Maximum="{Binding #Roll.VerticalMaximum}"
                       ViewportSize="{Binding #Roll.VerticalViewport}"
                       Value="{Binding #Roll.VerticalOffset, Mode=TwoWay}"
                       SmallChange="12" LargeChange="120" />
            <ScrollBar Grid.Row="1" Orientation="Horizontal" AllowAutoHide="False"
                       Minimum="0"
                       Maximum="{Binding #Roll.HorizontalMaximum}"
                       ViewportSize="{Binding #Roll.HorizontalViewport}"
                       Value="{Binding #Roll.HorizontalOffset, Mode=TwoWay}"
                       SmallChange="40" LargeChange="320" />
        </Grid>
    </DockPanel>
</Window>
