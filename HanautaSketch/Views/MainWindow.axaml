<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HanautaSketch.ViewModels"
        xmlns:c="using:HanautaSketch.Controls"
        xmlns:core="using:HanautaSketch.Engine.Core"
        x:Class="HanautaSketch.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800">
    <Window.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding TogglePlaybackCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>
    <DockPanel>
        <!-- ツールバー -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="開く" Command="{Binding OpenCommand}" ToolTip.Tip="Ctrl+O" />
            <Button Content="保存" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+S（Ctrl+Shift+S で名前を付けて保存）" />
            <ToggleButton Content="▶ 再生" Command="{Binding TogglePlaybackCommand}" IsChecked="{Binding IsPlaying, Mode=OneWay}" Width="80" Margin="16,0,0,0" />
            <TextBlock Text="BPM" VerticalAlignment="Center" Margin="8,0,0,0" />
            <NumericUpDown Value="{Binding Bpm}" Minimum="20" Maximum="400" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="Key" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding TonicNames}" SelectedIndex="{Binding Tonic}" Width="80" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="100" />
            <TextBlock Text="Snap" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding SnapOptions}" SelectedItem="{Binding SelectedSnap}" Width="90" />
            <TextBlock Text="Minor V" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding MinorDominantModes}" SelectedItem="{Binding MinorDominant}" Width="100" />
            <CheckBox Content="メロディも参照" IsChecked="{Binding UseMelodyForChords}" />
        </StackPanel>

        <!-- ステータスバー -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding AudioStatus}" Opacity="0.7" />
            <TextBlock Text="{Binding Message}" Opacity="0.7" />
        </DockPanel>

        <!-- トラックメニュー -->
        <ListBox DockPanel.Dock="Left" Width="160"
                 ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:NoteTrack">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <c:PianoRollControl Song="{Binding Song}"
                            Track="{Binding SelectedTrack}"
                            Key="{Binding Key}"
                            SnapTicks="{Binding SelectedSnap.Ticks}"
                            Chords="{Binding Chords}"
                            PlayheadTick="{Binding PlayheadTick}"
                            NotesEdited="OnNotesEdited" />
    </DockPanel>
</Window>
