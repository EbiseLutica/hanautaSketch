<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HanautaSketch.ViewModels"
        xmlns:res="using:HanautaSketch.Resources"
        x:Class="HanautaSketch.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="720" Height="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Styles>
    <!-- 左に観点のサイドバー、右にその観点の項目。変えたらすぐ反映するので、OK / キャンセルは置かず閉じるだけにする -->
    <Grid ColumnDefinitions="180,*">
        <Border Background="{DynamicResource LuPanelBrush}" BorderBrush="{DynamicResource LuDividerBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="SectionList" Background="Transparent" Margin="8" SelectionMode="AlwaysSelected" SelectedIndex="0" SelectionChanged="OnSectionChanged">
                <ListBoxItem Content="{x:Static res:Strings.SettingsSound}" />
                <ListBoxItem Content="{x:Static res:Strings.SettingsAppearance}" />
                <ListBoxItem Content="{x:Static res:Strings.SettingsChordTable}" />
            </ListBox>
        </Border>

        <DockPanel Grid.Column="1" Margin="24,20">
            <Panel>
                <!-- サウンド -->
                <StackPanel x:Name="SoundPage" Spacing="10">
                    <TextBlock Classes="pageTitle" Text="{x:Static res:Strings.SettingsSound}" />
                    <TextBlock Text="{x:Static res:Strings.SoundFontLabel}" VerticalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Text="{Binding SoundFontDisplay}" ToolTip.Tip="{Binding SoundFontDisplay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.SoundFontChoose}" Command="{Binding ChooseSoundFontCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 表示 -->
                <StackPanel x:Name="AppearancePage" Spacing="10" IsVisible="False">
                    <TextBlock Classes="pageTitle" Text="{x:Static res:Strings.SettingsAppearance}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Text="{x:Static res:Strings.ThemeMenu}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" MinWidth="180" />
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.LanguageMenu}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}" MinWidth="180" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static res:Strings.LanguageRestartNotice}" Classes="dimmed" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <!-- コードテーブル -->
                <StackPanel x:Name="ChordTablePage" Spacing="10" IsVisible="False">
                    <TextBlock Classes="pageTitle" Text="{x:Static res:Strings.SettingsChordTable}" />
                    <TextBlock Text="{x:Static res:Strings.ChordDataSettingsHint}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChordDataState}" Classes="dimmed" />
                    <TextBlock Classes="section" Text="{x:Static res:Strings.ChordDataTitle}" />
                    <TextBlock Text="{Binding ChordDataStatus}" Classes="dimmed" IsVisible="{Binding IsExtractingChordData}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static res:Strings.ChordDataAcquire}" Command="{Binding AcquireChordDataCommand}" />
                        <Button Content="{x:Static res:Strings.StopExtraction}" Command="{Binding CancelChordDataCommand}"
                                IsVisible="{Binding IsExtractingChordData}" />
                        <Button Content="{x:Static res:Strings.ChordDataRemove}" Classes="danger" Command="{Binding RemoveChordDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
